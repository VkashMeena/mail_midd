# ==============================================================================
# AI Smart Mail Manager - Environment Configuration Template (.env.example)
# Copy this file to .env and populate with production / development secrets.
# ==============================================================================

# Core Django Settings
DEBUG=False
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.com

# Database Connection (PostgreSQL in Production, SQLite fallback)
# Production PostgreSQL example: postgres://dbuser:dbpassword@127.0.0.1:5432/smartmail_db
# Local SQLite development default: sqlite:///db.sqlite3
DATABASE_URL=sqlite:///db.sqlite3

# Celery & Redis Task Broker
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CHANNELS_REDIS_URL=redis://127.0.0.1:6379/2

# Production Security & SSL
SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO

# Google OAuth 2.0 & Gmail Integration
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/gmail/oauth/callback/
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/userinfo.email
GMAIL_TOKEN_ENCRYPTION_KEY=your-fernet-compatible-32-byte-base64-encryption-key
GMAIL_INITIAL_SYNC_LIMIT=100
GMAIL_SYNC_BATCH_SIZE=25
GMAIL_SYNC_INTERVAL_SECONDS=300

# AI Engine Configuration (OpenAI / Ollama / Custom Provider)
AI_PROVIDER=openai
AI_API_KEY=sk-your-openai-api-key-here
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=500
AI_CLASSIFICATION_ENABLED=True
AI_MAX_EMAIL_CHARS=10000
AI_BATCH_SIZE=10
AI_TIMEOUT=30
AI_BASE_URL=

# Groq API Configuration (Fast LPU Inference - Free tier available at https://console.groq.com)
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b


# Email Backend Configuration (Password Reset & System Alerts)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-service-account@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@smartmail.ai

# Real-Time Notifications & Web Push (Phase 6)
WEBSOCKET_ENABLED=True
WEB_PUSH_ENABLED=False
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@smartmail.ai
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_POLL_INTERVAL=30

# AI Daily Summary & Smart Reply (Phase 7)
AI_SUMMARY_MAX_EMAILS=100
AI_SUMMARY_MAX_TOKENS=1200
AI_REPLY_MAX_EMAIL_CHARS=12000
AI_REPLY_MAX_TOKENS=700
